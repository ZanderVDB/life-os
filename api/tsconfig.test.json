{
  // Type-checks the tests, which the build config deliberately excludes.
  // `tsx --test` only strips types, so without this a type error in a test
  // file is never reported by anything.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
