# Life OS v2 API — variable NAMES only, deliberately with no values.
# Copy to .env and fill in locally. NEVER commit a real .env.
# Deployed values live only in Railway's variable store.
#
# For local work you need none of this: `npm run dev:local` runs the whole API
# on an in-memory Postgres with no configuration at all.

# development | test | staging | production
NODE_ENV=

# Railway sets this automatically on a deployed service. Leave blank locally.
PORT=

# fatal | error | warn | info | debug | trace
LOG_LEVEL=

# Postgres connection string. In Railway, reference the database service's
# variable rather than pasting a literal value.
DATABASE_URL=

# Firebase project id. Binds the token's issuer and audience to one project.
# NOTE: no service account and no private key are required. Firebase ID tokens
# are RS256 JWTs signed by Google and verified against Google's PUBLIC keys.
FIREBASE_PROJECT_ID=

# Comma-separated EXACT origins allowed to call this API. Never "*" — the app
# refuses to start if a wildcard appears here.
CORS_ALLOWED_ORIGINS=

# Local and test only: accepts one fixed fake bearer token. The app refuses to
# boot if this is set while NODE_ENV is staging or production.
DEV_AUTH_BYPASS=

# ── The assistant ────────────────────────────────────────────────────────
# Without a key the app still boots and every read still works; the assistant
# says it is not connected to a model rather than failing obscurely.
#
# Anthropic API key. Get one at https://console.anthropic.com/settings/keys.
# This is the ONLY place a model key exists — the browser never sees it.
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults are in ai/providers/anthropic.ts:
#   AI_MODEL_PLAN   the expensive reasoning job   (default claude-sonnet-4-5)
#   AI_MODEL_ANSWER answering from sources        (default claude-sonnet-4-5)
#   AI_MODEL_FAST   classification and extraction (default claude-haiku-4-5-20251001)
AI_MODEL_PLAN=
AI_MODEL_ANSWER=
AI_MODEL_FAST=
