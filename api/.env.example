# Life OS v2 API — copy to .env for local development.
# NEVER commit a real .env. Secrets live only in Railway variables.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Railway PostgreSQL provides this. Local dev can point at any Postgres.
DATABASE_URL=postgresql://user:pass@localhost:5432/life_os_v2

# Firebase project id — used to validate the ID token's audience/issuer.
# NOTE: no service account or private key is required. Firebase ID tokens are
# RS256 JWTs signed by Google and verified against Google's PUBLIC keys.
FIREBASE_PROJECT_ID=life-os-a25bc

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: allow a fake bearer token in tests/local dev ONLY.
# Must remain unset in staging and production.
DEV_AUTH_BYPASS=
